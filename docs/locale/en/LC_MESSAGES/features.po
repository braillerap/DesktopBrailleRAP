#: ../../features.md:1
msgid "Fonctionalités"
msgstr "Features"

#: ../../features.md:3
msgid "Les principales fonctionnalités de DesktopBrailleRAP sont:"
msgstr "DesktopBrailleRAP's main features are:"

#: ../../features.md:4
msgid "Importer des images au format SVG"
msgstr "Import SVG images"

#: ../../features.md:5
msgid "Ajouter des blocs d'annotation en Braille"
msgstr "Add text blocks in Braille"

#: ../../features.md:6
msgid "Déplacer, orienter, redimensionner les graphiques importés."
msgstr "Move, rotate, scale imported graphics."

#: ../../features.md:7
msgid "Déplacer, orienter les blocs d'annotation en Braille."
msgstr "Move, rotate Braille text blocks."

#: ../../features.md:8
msgid "Sauvegarder une composition."
msgstr "Save a composition."

#: ../../features.md:9
msgid "Charger une composition."
msgstr "Load a composition."

#: ../../features.md:10
msgid ""
"Attribuer des motifs de points Braille pour le remplissage des aplats de "
"couleurs."
msgstr "Assign Braille dot patterns for the filling of color patches."

#: ../../features.md:11
msgid "Attribuer des motifs de lignes à des couleurs de lignes."
msgstr "Assign Braille dot patterns to line colors."

#: ../../features.md:12
msgid "Embosser (imprimer) une composition sur une BrailleRAP connectée en USB."
msgstr "Emboss (print) a composition on a USB connected BrailleRAP."

#: ../../features.md:14
msgid "Tour d'horizon des fonctions de DesktopBrailleRAP"
msgstr "DesktopBrailleRAP's main features"

#: ../../features.md:16
msgid "Les options du menu principal"
msgstr "Main menu options"

#: ../../features.md:18
msgid "Accueil"
msgstr "Home"

#: ../../features.md:19
msgid "Affiche une page d'information sur le logiciel."
msgstr "Display some information about the software."

#: ../../features.md:21
msgid "Fichiers"
msgstr "Files"

#: ../../features.md:22
msgid ""
"Affiche les options relatives à l'enregistrement ou la lecture d'un "
"fichier contenant une composition (extension .brp)"
msgstr ""
"Displays options for saving or playing a file containing a composition "
"(extension .brp)"

#: ../../features.md:24
msgid "![Capture d'écran de la page fichier](./IMG/formfiles.jpg)"
msgstr "![Screenshot of file page](./IMG/formfiles.jpg)"

#: ../../features.md:24
msgid "Capture d'écran de la page fichier"
msgstr "Screenshot of file page"

#: ../../features.md:26
msgid "Import SVG"
msgstr "SVG Import"

#: ../../features.md:27
msgid "Afficher les options relatives à l'importation d'un fichier SVG"
msgstr "Display options related to importing an SVG file"

#: ../../features.md:29
msgid "![Capture d'écran de la page import svg](./IMG/formsvg.jpg)"
msgstr "![Screenshot of the SVG import page](./IMG/formsvg.jpg)"

#: ../../features.md:29
msgid "Capture d'écran de la page import svg"
msgstr "Screenshot of the SVG import page"

#: ../../features.md:31
msgid "Texte"
msgstr "Text"

#: ../../features.md:32
msgid "Affiche les options relatives à l'ajout de bloc texte"
msgstr "Displays options related to adding a text block"

#: ../../features.md:34
msgid "![Capture d'écran de la page texte](./IMG/formtext.jpg)"
msgstr "![Screenshot of text page](./IMG/formtext.jpg)"

#: ../../features.md:34
msgid "Capture d'écran de la page texte"
msgstr "Screenshot of the text page"

#: ../../features.md:36
msgid "Position"
msgstr "Position"

#: ../../features.md:37
msgid ""
"Afficher les options relatives à la position,l'orientation ou l'échelle "
"des graphiques et des blocs de texte."
msgstr ""
"Display options related to the position, orientation, or scale of graphics "
"and text blocks."

#: ../../features.md:39
msgid "![Capture d'écran de la page position](./IMG/formposition.jpg)"
msgstr "![Screenshot of the position page](./IMG/formposition.jpg)"

#: ../../features.md:39
msgid "Capture d'écran de la page position"
msgstr "Screenshot of the position page"

#: ../../features.md:41
msgid "Motif"
msgstr "Pattern"

#: ../../features.md:42
msgid ""
"Affiche les options relatives à l'association de motif à une couleur de "
"remplissage ou une couleur de ligne"
msgstr ""
"Displays options related to associating a pattern with a fill color or line "
"color"

#: ../../features.md:44
msgid "![Capture d'écran de la page motif](./IMG/formpattern.jpg)"
msgstr "![Screenshot of pattern page](./IMG/formpattern.jpg)"

#: ../../features.md:44 ../../features.md:49
msgid "Capture d'écran de la page motif"
msgstr "Screenshot of the pattern page"

#: ../../features.md:46
msgid "Imprimer"
msgstr "Print"

#: ../../features.md:47
msgid ""
"Affiche un aperçu avant impression ainsi que les options pour imprimer le"
" document sur une BrailleRAP."
msgstr ""
"Displays a print preview as well as options for printing the document on a "
"BrailleRAP."

#: ../../features.md:49
msgid "![Capture d'écran de la page motif](./IMG/formprint.jpg)"
msgstr "![Screenshot of the pattern page](./IMG/formprint.jpg)"

#: ../../features.md:51
msgid "Paramètres"
msgstr "Settings"

#: ../../features.md:52
msgid "Affiche les options relatives à la configuration du logiciel."
msgstr "Displays options related to software configuration."

#: ../../features.md:54
msgid "![Capture d'écran de la page des paramètres](./IMG/formoption.jpg)"
msgstr "![Screenshot of the settings page](./IMG/formoption.jpg)"

#: ../../features.md:54
msgid "Capture d'écran de la page des paramètres"
msgstr "Screenshot of the settings page"

#: ../../features.md:56
msgid "Données"
msgstr "Data"

#: ../../features.md:57
msgid "Affiche un résumé de la composition active."
msgstr "Displays a summary of the active composition."
